import java.util.*;

abstract class CourseType {
    String name;

    CourseType(String name) {
        this.name = name;
    }

    public String toString() {
        return name;
    }
}

class ExamCourse extends CourseType {
    ExamCourse(String name) {
        super(name);
    }
}

class AssignmentCourse extends CourseType {
    AssignmentCourse(String name) {
        super(name);
    }
}

class ResearchCourse extends CourseType {
    ResearchCourse(String name) {
        super(name);
    }
}

class Course<T extends CourseType> {
    ArrayList<T> list = new ArrayList<>();

    void add(T c) {
        list.add(c);
    }

    List<T> getCourses() {
        return list;
    }
}

public class Question3 {

    static void display(List<? extends CourseType> list) {
        for (CourseType c : list)
            System.out.println(c);
    }

    public static void main(String[] args) {

        Course<ExamCourse> c = new Course<>();

        c.add(new ExamCourse("Java"));
        c.add(new ExamCourse("Python"));

        display(c.getCourses());
    }
}