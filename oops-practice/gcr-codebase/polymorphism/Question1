class Vehicle {
    double fuelCost(int km) {
        return 0;
    }
}

class Car extends Vehicle {
    double fuelCost(int km) {
        return km * 8;
    }
}

class Bus extends Vehicle {
    double fuelCost(int km) {
        return km * 15;
    }
}

class Bike extends Vehicle {
    double fuelCost(int km) {
        return km * 3;
    }
}

class ElectricCar extends Vehicle {
    double fuelCost(int km) {
        return km * 2;
    }
}

public class Question1 {
    public static void main(String[] args) {

        Vehicle[] v = new Vehicle[4];

        v[0] = new Car();
        v[1] = new Bus();
        v[2] = new Bike();
        v[3] = new ElectricCar();

        int km = 20;

        for (Vehicle i : v) {
            if (i instanceof Car) {
                Car c = (Car) i;
                System.out.println("Car Cost : " + c.fuelCost(km));
            } else if (i instanceof Bus) {
                Bus b = (Bus) i;
                System.out.println("Bus Cost : " + b.fuelCost(km));
            } else if (i instanceof Bike) {
                Bike b = (Bike) i;
                System.out.println("Bike Cost : " + b.fuelCost(km));
            } else if (i instanceof ElectricCar) {
                ElectricCar e = (ElectricCar) i;
                System.out.println("Electric Car Cost : " + e.fuelCost(km));
            }
        }
    }
}